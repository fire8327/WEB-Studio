{
  "$schema": "https://design-tokens.org/schema/v1",
  "meta": {
    "name": "LAYER.DEV Design System",
    "version": "1.0.0",
    "description": "Precision Dark Engineering design tokens for Vue / Nuxt White Label & Outstaffing B2B Studio",
    "cssVarPrefix": "--",
    "baseUnit": "4px"
  },
  "colors": {
    "bg": {
      "canvas": "#090B10",
      "canvasAlt": "#0D1017",
      "surface": "#121620",
      "surfaceElevated": "#181D2A",
      "surfaceHover": "#1E2434",
      "glass": "rgba(18, 22, 32, 0.72)",
      "glassStrong": "rgba(13, 16, 23, 0.88)",
      "lightBand": "#F4F6FA",
      "lightCard": "#FFFFFF",
      "lightCardHover": "#EEF2F7"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.07)",
      "default": "rgba(255, 255, 255, 0.12)",
      "strong": "rgba(255, 255, 255, 0.22)",
      "accent": "rgba(0, 220, 130, 0.42)",
      "indigo": "rgba(99, 102, 241, 0.40)",
      "lightSubtle": "rgba(11, 13, 18, 0.10)",
      "lightStrong": "rgba(11, 13, 18, 0.20)"
    },
    "text": {
      "primary": "#F8FAFC",
      "secondary": "#94A3B8",
      "muted": "#64748B",
      "inversePrimary": "#090B10",
      "inverseSecondary": "#475569",
      "accent": "#00DC82",
      "accentHover": "#34F5A4"
    },
    "brand": {
      "emerald": "#00DC82",
      "emeraldHover": "#1EEB96",
      "emeraldActive": "#00B86B",
      "emeraldTint": "rgba(0, 220, 130, 0.12)",
      "emeraldGlow": "rgba(0, 220, 130, 0.28)",
      "indigo": "#6366F1",
      "indigoHover": "#818CF8",
      "indigoTint": "rgba(99, 102, 241, 0.14)",
      "indigoGlow": "rgba(99, 102, 241, 0.28)",
      "cyan": "#38BDF8",
      "cyanTint": "rgba(56, 189, 248, 0.12)",
      "telegram": "#2AABEE",
      "vk": "#0077FF"
    },
    "semantic": {
      "success": "#10B981",
      "successTint": "rgba(16, 185, 129, 0.14)",
      "warning": "#F59E0B",
      "warningTint": "rgba(245, 158, 11, 0.14)",
      "error": "#EF4444",
      "errorTint": "rgba(239, 68, 68, 0.14)",
      "ndaShield": "#F43F5E",
      "ndaShieldTint": "rgba(244, 63, 94, 0.14)"
    },
    "gradients": {
      "heroAmbient": "radial-gradient(60% 50% at 50% 0%, rgba(0, 220, 130, 0.14) 0%, rgba(99, 102, 241, 0.08) 45%, rgba(9, 11, 16, 0) 100%)",
      "emeraldButton": "linear-gradient(135deg, #00DC82 0%, #00B86B 100%)",
      "bentoBorderHighlight": "linear-gradient(135deg, rgba(0, 220, 130, 0.35) 0%, rgba(255, 255, 255, 0.06) 50%, rgba(99, 102, 241, 0.35) 100%)",
      "textAccent": "linear-gradient(90deg, #F8FAFC 0%, #00DC82 55%, #38BDF8 100%)"
    }
  },
  "typography": {
    "fonts": {
      "sans": {
        "family": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "googleFont": "Manrope:wght@400;500;600;700;800",
        "weights": [400, 500, 600, 700, 800],
        "subsets": ["cyrillic", "latin"]
      },
      "mono": {
        "family": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "googleFont": "JetBrains+Mono:wght@400;500;600;700",
        "weights": [400, 500, 600, 700],
        "subsets": ["cyrillic", "latin"]
      }
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap",
    "scale": {
      "display": {
        "fontSize": "clamp(2.25rem, 4.5vw, 4rem)",
        "fontSizeDesktop": "4rem",
        "fontSizeMobile": "2.25rem",
        "lineHeight": "1.06",
        "letterSpacing": "-0.035em",
        "fontWeight": 800
      },
      "h1": {
        "fontSize": "clamp(2rem, 3.6vw, 3.25rem)",
        "fontSizeDesktop": "3.25rem",
        "fontSizeMobile": "2rem",
        "lineHeight": "1.1",
        "letterSpacing": "-0.03em",
        "fontWeight": 800
      },
      "h2": {
        "fontSize": "clamp(1.625rem, 2.5vw, 2.5rem)",
        "fontSizeDesktop": "2.5rem",
        "fontSizeMobile": "1.625rem",
        "lineHeight": "1.15",
        "letterSpacing": "-0.025em",
        "fontWeight": 700
      },
      "h3": {
        "fontSize": "clamp(1.25rem, 1.5vw, 1.5rem)",
        "fontSizeDesktop": "1.5rem",
        "fontSizeMobile": "1.25rem",
        "lineHeight": "1.25",
        "letterSpacing": "-0.02em",
        "fontWeight": 700
      },
      "h4": {
        "fontSize": "1.125rem",
        "lineHeight": "1.35",
        "letterSpacing": "-0.01em",
        "fontWeight": 600
      },
      "bodyLg": {
        "fontSize": "1.125rem",
        "lineHeight": "1.6",
        "letterSpacing": "-0.005em",
        "fontWeight": 400
      },
      "body": {
        "fontSize": "1rem",
        "lineHeight": "1.6",
        "letterSpacing": "0em",
        "fontWeight": 400
      },
      "bodySm": {
        "fontSize": "0.875rem",
        "lineHeight": "1.5",
        "letterSpacing": "0em",
        "fontWeight": 500
      },
      "caption": {
        "fontSize": "0.75rem",
        "lineHeight": "1.4",
        "letterSpacing": "0.02em",
        "fontWeight": 500
      },
      "monoBadge": {
        "fontSize": "0.75rem",
        "lineHeight": "1.2",
        "letterSpacing": "0.04em",
        "fontWeight": 600,
        "fontVariantNumeric": "tabular-nums"
      },
      "monoMetric": {
        "fontSize": "clamp(1.5rem, 2.2vw, 2.25rem)",
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em",
        "fontWeight": 700,
        "fontVariantNumeric": "tabular-nums"
      }
    }
  },
  "spacing": {
    "scale": {
      "0": "0px",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "28": "7rem",
      "32": "8rem"
    },
    "layout": {
      "containerMaxWidth": "1280px",
      "containerNarrowWidth": "960px",
      "containerPaddingMobile": "1rem",
      "containerPaddingTablet": "1.5rem",
      "containerPaddingDesktop": "2rem",
      "gridGapMobile": "1rem",
      "gridGapDesktop": "1.5rem",
      "sectionPyMobile": "4rem",
      "sectionPyTablet": "5.5rem",
      "sectionPyDesktop": "7rem",
      "headerHeightMobile": "4rem",
      "headerHeightDesktop": "4.5rem"
    }
  },
  "radii": {
    "none": "0px",
    "xs": "0.375rem",
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "pill": "9999px"
  },
  "shadows": {
    "card": "0 1px 2px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.05)",
    "cardHover": "0 12px 32px -8px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(0, 220, 130, 0.28)",
    "elevated": "0 20px 48px -12px rgba(0, 0, 0, 0.72)",
    "glass": "0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08)",
    "glowEmerald": "0 0 28px -4px rgba(0, 220, 130, 0.42)",
    "glowIndigo": "0 0 28px -4px rgba(99, 102, 241, 0.36)",
    "focusRing": "0 0 0 2px #090B10, 0 0 0 4px #00DC82",
    "focusRingLight": "0 0 0 2px #FFFFFF, 0 0 0 4px #00B86B"
  },
  "breakpoints": {
    "xs": "360px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "motion": {
    "durations": {
      "instant": "100ms",
      "fast": "180ms",
      "normal": "280ms",
      "slow": "450ms",
      "reveal": "600ms"
    },
    "easings": {
      "standard": "cubic-bezier(0.22, 1, 0.36, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "reducedMotionPolicy": "Disable transform/parallax transitions; keep opacity fades <= 150ms when prefers-reduced-motion: reduce"
  },
  "zIndex": {
    "base": 0,
    "elevated": 10,
    "sticky": 20,
    "header": 40,
    "dropdown": 50,
    "drawer": 60,
    "modal": 70,
    "toast": 80,
    "tooltip": 90
  }
}
